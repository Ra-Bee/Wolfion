# =============================================================================
# Wolfion environment variables
# Copy this file to `.env` and fill in real values from your own service
# accounts. NEVER commit the filled-in .env file.
# =============================================================================

# -- Clerk (auth) -- https://dashboard.clerk.com -> API Keys --------------------
# Publishable key is safe to ship in the browser bundle (Vite inlines
# VITE_-prefixed vars at build time). Secret key must stay server-only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- Firebase (RTDB + auth bridge) -- https://console.firebase.google.com ------
# Web API key is a PUBLIC client identifier (it's baked into the bundle anyway).
VITE_FIREBASE_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service account JSON: download from Firebase Console -> Project settings ->
# Service accounts -> Generate new private key. Paste the ENTIRE file contents
# (a JSON object) as a single string. On Render, paste it in the env var UI.
# Locally you can put the JSON in .local/state/firebase-sa.json instead and
# the server will fall back to reading that file.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# -- API server runtime --------------------------------------------------------
NODE_ENV=development
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Postgres URL. The api-server only uses it for the legacy
# /api/products seed route. Cloud-synced admin data lives in Firebase RTDB.
DATABASE_URL=
